# Sangam Tours — public environment variables
# Copy to `.env.local` for local overrides (never commit secrets).
# Document 11 §3: configuration separate from code.

# Absolute site origin for canonical URLs, Open Graph, sitemap, and robots.
# Production should match the live hostname (https://www.sangamtours.com).
# NEXT_PUBLIC_SITE_URL=https://www.sangamtours.com

# Content adapter: `local` (default) | `empty` (EmptyState regression only).
# `empty` is refused when NODE_ENV=production.
# CONTENT_SOURCE=local
